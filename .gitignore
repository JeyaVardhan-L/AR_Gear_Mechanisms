# ==============================================================================
# Unity .gitignore — MECH-XR Augmented Reality Project
# ==============================================================================

# Unity generated cache & temporary directories
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/.utmp/

# Temporary / scratch execution files
/[Ss]cratch/
*.log
*.tmp
*.bak

# Builds directory: Exclude intermediate APKs, keep only latest verified release
/Builds/*
!/Builds/MECH-XR-PHASE6-1-v2.apk
!/Builds/README.md

# Visual Studio / VS Code / Rider IDE files
.vs/
.idea/
.vscode/
*.csproj
*.unityproj
*.sln
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity Autogenerated Roslyn Analyzers
/*.csproj
/*.sln
/*.ruleset

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
Desktop.ini

# Android native build intermediates
.cxx/
build/
captures/
